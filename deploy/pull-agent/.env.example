# Device LAN address (Menu -> COMM. -> Ethernet). Give the device a static IP.
DEVICE_IP=192.168.1.201
# ERPNext site running zk_push. Use https.
SITE_URL=https://erp.example.com
# Device Comm Key (COMM. -> PC Connection); 0 if none.
COMM_KEY=0
# Seconds between pulls.
INTERVAL=120
# Timezone for log timestamps.
TZ=Asia/Riyadh
# Image tag loaded from the package (docker images zk-pull-agent).
ZK_PULL_TAG=latest
