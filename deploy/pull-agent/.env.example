# Name of this agent; also names its state volume. Keep it when updating; one name per device
# (lowercase letters, digits, - and _).
ZK_PULL_NAME=zk-pull
# Device LAN address (Menu -> COMM. -> Ethernet). Give the device a static IP.
DEVICE_IP=192.168.1.201
# ERPNext site running zk_push. Use https.
SITE_URL=https://erp.example.com
# Device Comm Key (COMM. -> PC Connection); 0 if none.
COMM_KEY=0
# Seconds between pulls.
INTERVAL=120
# Never send punches before this year or date (2026, 2026-03 or 2026-03-15). Empty: the whole log.
SINCE=
# Timezone for log timestamps.
TZ=Asia/Riyadh
# Image: the one loaded from the package (docker images zk-pull-agent), or, with internet
# access, ZK_PULL_IMAGE=ghcr.io/t1nk333r/zk-pull-agent and ZK_PULL_TAG=latest.
ZK_PULL_IMAGE=zk-pull-agent
ZK_PULL_TAG=latest
